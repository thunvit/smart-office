// Cấu hình triển khai SmartOffice lên Cloudflare Workers (tự động qua Workers Builds khi đẩy mã lên nhánh main).
{
  "name": "smart-office",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],

  // Giao diện + PWA phục vụ trực tiếp từ thư mục public/; chỉ /api/* và /healthz đi vào Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"]
  },

  // Cơ sở dữ liệu: SQLite của Durable Object "SmartOffice".
  "durable_objects": {
    "bindings": [{ "name": "SO", "class_name": "SmartOffice" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SmartOffice"] }],

  "vars": {
    "PUBLIC_ORIGINS": "https://smartoffice.vnptninhbinh.com.vn",
    // "1" = nạp dữ liệu mẫu (bản trình diễn). Để trống = cơ sở dữ liệu trống, chỉ có tài khoản admin.
    "SO_DEMO": "",
    // Mã băm (scrypt) mật khẩu ban đầu của admin; mật khẩu gốc được bàn giao riêng cho chủ sở hữu, không lưu trong kho mã.
    // Chỉ có tác dụng khi admin chưa đổi mật khẩu lần đầu.
    "ADMIN_PASSWORD_HASH": "scrypt$d8678fc782c5557fbcc4183f9ab710a0$0e164084bec2c914ce8a3726f2183ef2427b090bcf542e4740e250aafa8993b0633d47786fdd530063b57bc3ecd994e16e71a7747f806abe831de6b189f0d92c"
  },
  // Bí mật ADMIN_PASSWORD (mật khẩu ban đầu của tài khoản admin) khai báo trên trang Cloudflare:
  // Workers & Pages > smart-office > Settings > Variables and Secrets. Không ghi mật khẩu vào tệp này.

  // Bật sau khi tên miền vnptninhbinh.com.vn đã nằm trên tài khoản Cloudflare (xem TRIEN-KHAI-CLOUDFLARE.md):
  // "routes": [{ "pattern": "smartoffice.vnptninhbinh.com.vn", "custom_domain": true }],

  "workers_dev": true,
  "observability": { "enabled": true }
}
