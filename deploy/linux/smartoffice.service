# /etc/systemd/system/smartoffice.service
[Unit]
Description=SmartOffice - phan mem van phong so
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smartoffice
WorkingDirectory=/opt/smartoffice
Environment=PORT=3000
Environment=TRUST_PROXY=1
Environment=PUBLIC_ORIGINS=https://smartoffice.vnptninhbinh.com.vn
Environment=DATA_DIR=/var/lib/smartoffice
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/smartoffice

[Install]
WantedBy=multi-user.target
