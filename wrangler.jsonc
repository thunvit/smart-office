// Cấu hình triển khai SmartOffice lên Cloudflare Workers (tự động qua Workers Builds khi đẩy mã lên nhánh main).
{
  "name": "smart-office",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],

  // Giao diện + PWA phục vụ trực tiếp từ thư mục public/; chỉ /api/* và /healthz đi vào Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"]
  },

  // Cơ sở dữ liệu: SQLite của Durable Object "SmartOffice".
  "durable_objects": {
    "bindings": [{ "name": "SO", "class_name": "SmartOffice" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SmartOffice"] }],

  "vars": {
    "PUBLIC_ORIGINS": "https://smartoffice.vnptninhbinh.com.vn",
    // "1" = nạp dữ liệu mẫu (bản trình diễn). Để trống = cơ sở dữ liệu trống, chỉ có tài khoản admin.
    "SO_DEMO": "",
    // "1" = trả chi tiết lỗi kỹ thuật trong phản hồi 500. Chỉ bật khi chẩn đoán sự cố, tắt ngay sau đó và ghi nhật ký phiên (CLAUDE.md 4.5).
    "SO_DEBUG": ""
  },
  // Bí mật ADMIN_PASSWORD (mật khẩu ban đầu của tài khoản admin, chỉ áp dụng một lần khi khởi tạo; P0-7) khai báo trên trang Cloudflare:
  // Workers & Pages > smart-office > Settings > Variables and Secrets. Không ghi mật khẩu vào tệp này.

  // Bật sau khi tên miền vnptninhbinh.com.vn đã nằm trên tài khoản Cloudflare (xem docs/03-trien-khai/TRIEN-KHAI-CLOUDFLARE.md):
  // "routes": [{ "pattern": "smartoffice.vnptninhbinh.com.vn", "custom_domain": true }],

  // Vị trí chạy Worker (ADR-010, bổ sung 07/11/2026): người dùng Việt Nam thường vào Cloudflare tại Hồng Kông (colo=HKG);
  // Anthropic, OpenAI, Gemini không phục vụ Hồng Kông nên trả 403 "Request not allowed". Cho Worker chạy gần Singapore
  // (azure:southeastasia) để lệnh gọi nhà cung cấp AI đi ra từ khu vực được hỗ trợ. Chỉ ảnh hưởng /api/* và /healthz;
  // giao diện tĩnh vẫn phục vụ tại điểm gần người dùng. Gỡ khối này là quay về như cũ.
  "placement": { "region": "azure:southeastasia" },

  "workers_dev": true,
  "observability": { "enabled": true }
}
